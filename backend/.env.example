# Backend runtime configuration
PORT=4000
# MongoDB connection (used in weeks 3-4); leave blank for file-only operation
MONGODB_URI=
MONGODB_DB=streamweaver
# Upload limits
MAX_UPLOAD_BYTES=2147483648
UPLOAD_DIR=./tmp/uploads
# Ingestion output (file-only mode) and batching
OUTPUT_DIR=./tmp/output
BATCH_SIZE=5000
# Sample endpoint
SAMPLE_ROW_LIMIT=1000
